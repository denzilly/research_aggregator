# Copy to .env and fill in. Never commit .env (it's gitignored).

# Required for OpenRouter scoring/summarization.
OPENROUTER_API_KEY=

# Optional: raises PubMed's E-utilities rate limit from 3 to 10 req/s.
NCBI_API_KEY=

# Optional: pins the OpenRouter model. Defaults to deepseek/deepseek-v4-flash.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Generate with `openssl rand -hex 32`. If left empty, write endpoints
# (favorite toggle, settings save, run-now) are open to anyone with the URL.
WRITE_SECRET=

# Simple password gate in front of the whole site. If left empty, the site
# is open to anyone with the URL (no login prompt at all).
SITE_PASSWORD=

# Signs the login session cookie. Required if SITE_PASSWORD is set.
# Generate with `openssl rand -hex 32`.
SECRET_KEY=

# If running via Docker, set this explicitly to match the container's
# mounted data volume (e.g. /app/data/phage_digest.db) — an empty value
# here is NOT the same as unset, since config.py's ./data/... default
# only applies when the key is absent from the environment entirely.
# If running natively (no Docker), leave unset to use that default.
DATABASE_PATH=/app/data/phage_digest.db
