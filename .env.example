# Copy to .env and fill in. Never commit .env (it's gitignored).

# Required for OpenRouter scoring/summarization.
OPENROUTER_API_KEY=

# Optional: raises PubMed's E-utilities rate limit from 3 to 10 req/s.
NCBI_API_KEY=

# Optional: pins the OpenRouter model. Defaults to deepseek/deepseek-v4-flash.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Simple password gate in front of the whole site — also the only gate on
# write actions (folder create/rename/delete, saving papers to folders,
# queries, run-now). If left empty, the site is open to anyone with the URL
# (no login prompt at all).
SITE_PASSWORD=

# Signs the login session cookie, and (regardless of whether SITE_PASSWORD
# is set) the short-lived session state used mid-handshake by "Log in with
# Zotero" below. Generate with `openssl rand -hex 32`.
SECRET_KEY=

# Optional: enables the "Log in with Zotero" button in Settings instead of
# just the paste-an-API-key path. Register an app at
# https://www.zotero.org/oauth/apps to get these — you'll need to give it a
# callback URL of <this site's public URL>/zotero/callback (e.g.
# https://phage.example.com/zotero/callback). Leave both blank to skip
# OAuth entirely; the manual API-key box in Settings needs neither.
ZOTERO_CLIENT_KEY=
ZOTERO_CLIENT_SECRET=

# If running via Docker, set this explicitly to match the container's
# mounted data volume (e.g. /app/data/phage_digest.db) — an empty value
# here is NOT the same as unset, since config.py's ./data/... default
# only applies when the key is absent from the environment entirely.
# If running natively (no Docker), leave unset to use that default.
DATABASE_PATH=/app/data/phage_digest.db
